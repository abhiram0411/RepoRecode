# Optional cloud identity. Leave unset for device-local mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Preferred modern public key. Set this OR the legacy anon key, not both.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Free-only local gateway. No AI provider or paid API is used.
APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=8788
HOST=127.0.0.1
# Optional free local feedback store. Leave empty to disable collection.
COMMUNITY_STORAGE_PATH=
# Generate a random token with at least 32 characters; never use VITE_ for this.
LOCAL_ADMIN_TOKEN=
# Optional operational delivery. Disabled until explicitly configured.
ALERTS_ENABLED=false
ALERT_STATE_PATH=./data/alert-state.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
APP_HEALTH_URL=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Generate a 32-byte random base64 key locally; store only in the server secret store.
GITHUB_TOKEN_ENCRYPTION_KEY=
